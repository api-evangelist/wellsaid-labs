          "name": "Render text to speech (streaming)",
          "request": {
            "name": "Render text to speech (streaming)",
            "description": {
              "content": "Renders the supplied text with the chosen voice avatar and returns the result as a stream of an audio file (MP3), not the finished file, so the client can begin playback with a low time-to-first-byte. Default keys are limited to 1,000 characters per request. Accepts a subset of SSML tags.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tts",
                "stream"
              ],
              "host": [
                "{{baseUrl}}"
              ],
